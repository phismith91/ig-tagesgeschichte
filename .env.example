DEEPL_API_KEY=
META_ACCESS_TOKEN=
IG_USER_ID=

# Optional: Agentische Vorkuratierung + narrative Caption.
# Leer lassen -> regelbasierte Fallback-Kuratierung (Jahr aufsteigend).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Optional: E-Mail-Benachrichtigungen bei Post-Erfolg/-Fehler und Health-Check.
# SMTP_FROM muss meist identisch mit SMTP_USER sein.
# Port 587 = STARTTLS (meist; Hetzner funktioniert damit, wenn 465 blockiert ist).
# Port 465 = SSL/TLS (kann bei manchen Hostern / Netzwerken blockiert sein).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
